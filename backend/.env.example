# ===========================================================================
#  PharmaStock — configuration du serveur
#  Copier ce fichier en « .env » puis compléter les lignes marquées [A REMPLIR].
#  Détail de chaque ligne : docs/7-REMPLIR-BACKEND-ENV.md
#  Règles : pas d'espace autour du « = », pas de guillemets, UTF-8 sans BOM.
# ===========================================================================

# --- Serveur ---
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
# Adresses supplémentaires autorisées (téléphone/tablette sur le réseau de l'officine).
# Exemple : http://192.168.1.25:5173
APP_ORIGIN_EXTRA=
TRUST_PROXY=0
SESSION_HOURS=8

# --- Base de données PostgreSQL ---
# Le plus simple : « npm run setup » crée le rôle, la base et ce fichier .env.
# À la main : mot de passe = celui du rôle applicatif ; si le mot de passe contient
# @ : / ? & # %  ->  il faut l'encoder (p@ss -> p%40ss).
DATABASE_URL=postgres://pharmastock:CHANGE_ME@127.0.0.1:5432/pharmacie_stock
DATABASE_SSL=false

# --- Création initiale du premier administrateur (usage unique) ---
# [A REMPLIR] ADMIN_PASSWORD : 12 caractères minimum, sert une seule fois à
# « npm run admin:create », puis la ligne doit être effacée.
# Les autres utilisateurs se créent dans l'application (écran Utilisateurs).
ADMIN_LOGIN=admin
ADMIN_NAME=Administrateur
ADMIN_PASSWORD=

# --- Démonstration : obligatoire et explicite, jamais en production ---
# true = autorise « npm run demo:seed » (6 médicaments fictifs). Passer à false en réel.
ALLOW_DEMO=false

# Remarque : le nom de la pharmacie ne se règle PAS ici mais dans l'application
# (Pilotage > Paramètres). Aucune variable SESSION_SECRET n'est utilisée : les
# sessions sont des jetons aléatoires conservés en base.
